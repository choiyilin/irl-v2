{
  "name": "irl",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "20.18.x",
    "pnpm": "9.x"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --ci",
    "test:mutation": "stryker run",
    "supabase:types": "supabase gen types typescript --local > src/api/supabase/types.generated.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "maestro:test": "maestro test .maestro",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@hookform/resolvers": "^3.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase-cache-helpers/postgrest-react-query": "^1.10.0",
    "@supabase/supabase-js": "^2.99.1",
    "@tanstack/react-query": "^5.59.0",
    "date-fns": "^3.6.0",
    "expo": "~55.0.6",
    "expo-application": "~55.0.0",
    "expo-constants": "~55.0.8",
    "expo-device": "~55.0.0",
    "expo-image": "~3.0.0",
    "expo-image-manipulator": "~14.0.0",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "~55.0.7",
    "expo-notifications": "~0.32.0",
    "expo-router": "~55.0.6",
    "expo-splash-screen": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "lucide-react-native": "^0.462.0",
    "posthog-react-native": "^3.13.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.54.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.8.0",
    "react-native-unistyles": "^3.0.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.7.2",
    "sentry-expo": "~7.2.0",
    "zod": "^3.23.8"
