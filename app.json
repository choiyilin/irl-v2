{
  "expo": {
    "name": "IRL",
    "slug": "irl",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "irl",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.irl.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "IRL needs access to your photo library so you can add profile photos.",
        "NSCameraUsageDescription": "IRL needs camera access so you can take a photo for your profile.",
        "NSLocationWhenInUseUsageDescription": "IRL uses your location to show local promotions near you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-notifications",
      [
        "expo-image",
        {
          "ios": { "useExpoAssets": true }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_ME_AFTER_EAS_INIT"
      }
    },
    "owner": "irl"
  }
}
